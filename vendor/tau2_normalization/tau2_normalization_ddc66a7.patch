@@ -59,6 +59,41 @@ llm_log_dir: ContextVar[Optional[Path]] = ContextVar("llm_log_dir", default=None
 # Context variable to store the LLM logging mode ("all" or "latest")
 llm_log_mode: ContextVar[str] = ContextVar("llm_log_mode", default="latest")
 
+
+def _loads_tool_arguments(arguments: Any) -> dict[str, Any]:
+    """Parse model-emitted tool-call arguments defensively.
+
+    OpenAI-compatible local backends occasionally return a valid JSON object
+    followed by extra text or a second object, which makes `json.loads()` raise
+    `JSONDecodeError: Extra data` and abort the whole simulation.  Standard JSON
+    is still the primary path; the fallback uses the stdlib raw decoder to take
+    the first object only.  If the first JSON value is not an object, preserve it
+    under `value` so downstream tool execution still receives a dict.
+    """
+    if isinstance(arguments, dict):
+        return arguments
+    if arguments is None:
+        return {}
+    text = str(arguments).strip()
+    if not text:
+        return {}
+    try:
+        parsed = json.loads(text)
+    except json.JSONDecodeError:
+        start = text.find("{")
+        if start < 0:
+            raise
+        parsed, end = json.JSONDecoder().raw_decode(text[start:])
+        trailing = text[start + end :].strip()
+        if trailing:
+            logger.warning(
+                "Recovered tool-call arguments from malformed JSON; "
+                f"ignored trailing text: {trailing[:120]!r}"
+            )
+    if isinstance(parsed, dict):
+        return parsed
+    return {"value": parsed}
+
